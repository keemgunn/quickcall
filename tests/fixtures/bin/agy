#!/usr/bin/env node
/** Fixture `agy` (antigravity) — records argv/cwd, emits { response, conversation_id }. */
import { writeFileSync } from "node:fs";

const argv = process.argv.slice(2);
if (process.env.QC_RECORD) {
  writeFileSync(process.env.QC_RECORD, JSON.stringify({ argv, stdin: "", cwd: process.cwd() }));
}
if (process.env.QC_AGY_STDERR) process.stderr.write(process.env.QC_AGY_STDERR);

if (process.env.QC_AGY_ERROR) {
  process.stdout.write(
    `${JSON.stringify({ status: "ERROR", conversation_id: "", error: process.env.QC_AGY_ERROR, response: "" })}\n`,
  );
  process.exit(Number(process.env.QC_AGY_EXIT ?? "1"));
}

const conversation = argv.indexOf("--conversation");
const conversationId =
  (conversation >= 0 && argv[conversation + 1]) ||
  process.env.QC_AGY_SESSION ||
  "conv_fixture_agy";
const text = process.env.QC_AGENT_TEXT ?? "agy-assistant";
const payload = { response: text, conversation_id: conversationId };
if (process.env.QC_AGY_USAGE === "1") {
  payload.usage = {
    input_tokens: 1200,
    output_tokens: 400,
    thinking_tokens: 20,
    cache_read_tokens: 50,
    total_tokens: 1660,
  };
}
process.stdout.write(`${JSON.stringify(payload)}\n`);
process.exit(Number(process.env.QC_AGY_EXIT ?? "0"));
