#!/usr/bin/env node
/** Fixture Cursor `agent` binary — records argv/cwd, emits { result, session_id }. */
import { writeFileSync } from "node:fs";

const argv = process.argv.slice(2);
if (process.env.QC_RECORD) {
  writeFileSync(process.env.QC_RECORD, JSON.stringify({ argv, stdin: "", cwd: process.cwd() }));
}
if (process.env.QC_AGENT_STDERR) process.stderr.write(process.env.QC_AGENT_STDERR);
if (process.env.QC_AGENT_EMPTY_JSON) {
  process.exit(Number(process.env.QC_AGENT_EXIT ?? "1"));
}

const resume = argv.indexOf("--resume");
const sessionId =
  resume >= 0 && argv[resume + 1]
    ? argv[resume + 1]
    : process.env.QC_CURSOR_SESSION ?? "11111111-2222-3333-4444-555555555555";
const text = process.env.QC_AGENT_TEXT ?? "cursor-assistant";

process.stdout.write(`${JSON.stringify({ result: text, session_id: sessionId })}\n`);
process.exit(Number(process.env.QC_AGENT_EXIT ?? "0"));
