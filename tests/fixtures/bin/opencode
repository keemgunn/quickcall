#!/usr/bin/env node
/** Fixture `opencode` — records argv/cwd, emits JSONL text + session events. QC_OPENCODE_ERROR emits type:error. */
import { writeFileSync } from "node:fs";

const argv = process.argv.slice(2);
if (process.env.QC_RECORD) {
  writeFileSync(process.env.QC_RECORD, JSON.stringify({ argv, stdin: "", cwd: process.cwd() }));
}
if (process.env.QC_OPENCODE_STDERR) process.stderr.write(process.env.QC_OPENCODE_STDERR);

const resume = argv.indexOf("-s");
const title = argv.indexOf("--title");
const sessionId =
  (resume >= 0 && argv[resume + 1]) ||
  process.env.QC_OPENCODE_SESSION ||
  "ses_fixture_opencode";

if (process.env.QC_OPENCODE_ERROR) {
  process.stdout.write(`${JSON.stringify({ type: "session", sessionID: sessionId })}\n`);
  process.stdout.write(
    `${JSON.stringify({
      type: "error",
      sessionID: sessionId,
      error: { name: "UnknownError", data: { message: process.env.QC_OPENCODE_ERROR } },
    })}\n`,
  );
  process.exit(Number(process.env.QC_OPENCODE_EXIT ?? "1"));
}
const text = process.env.QC_AGENT_TEXT ?? "opencode-assistant";

process.stdout.write(`${JSON.stringify({ type: "session", sessionID: sessionId })}\n`);
if (title >= 0 && argv[title + 1]) {
  process.stdout.write(`${JSON.stringify({ type: "title", title: argv[title + 1] })}\n`);
}
process.stdout.write(`${JSON.stringify({ type: "text", part: { type: "text", text } })}\n`);
process.exit(Number(process.env.QC_OPENCODE_EXIT ?? "0"));
