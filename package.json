{
  "name": "@keemgunn/quickcall",
  "version": "0.2.0",
  "description": "Run reusable Markdown prompts through headless agent tools (pi, cursor, claude, opencode, antigravity, codex).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qc": "bin/qc"
  },
  "files": [
    "bin",
    "dist",
    "share",
    "scripts",
    "USAGE.md",
    "PROVIDERS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemgunn/quickcall.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bash ./scripts/build.sh --profile release",
    "lint": "cargo fmt --all -- --check && cargo clippy --locked --all-targets --all-features -- -D warnings",
    "dev": "bash ./scripts/build.sh --profile debug",
    "postinstall": "node ./scripts/postinstall.mjs",
    "test:unit": "bash ./scripts/test.sh unit",
    "test:integration": "bash ./scripts/test.sh integration",
    "test:smoke": "bash ./scripts/test.sh smoke"
  },
  "dependencies": {
    "detect-libc": "2.1.2"
  }
}
